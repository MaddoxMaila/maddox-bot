{
  "name": "@maddox-bot/agent-tools",
  "version": "0.1.0",
  "private": true,
  "description": "ToolRegistry and tool implementations (git/repo/github/jira/shell) exposed to agent-core.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@maddox-bot/git": "workspace:*",
