# Copy to .env and fill in. Never commit the real .env file.

# --- packages/database (increment 3) ---
DATABASE_URL="postgresql://maddox:maddox@localhost:5433/maddox_bot"

# --- packages/queue (increment 4) ---
REDIS_URL="redis://localhost:6380"

# --- packages/github (increment 5) ---
# Fine-grained Personal Access Token scoped to the target repo(s): contents, pull requests, issues (read+write).
GITHUB_TOKEN=
# Shared secret configured on the target repo's webhook (Settings > Webhooks).
GITHUB_WEBHOOK_SECRET=

# --- packages/jira (increment 6) ---
JIRA_BASE_URL="https://your-site.atlassian.net"
JIRA_EMAIL=
JIRA_API_TOKEN=
# Shared secret appended to the Jira automation webhook URL Forge listens on (Jira has no built-in webhook signing).
JIRA_WEBHOOK_SECRET=

# --- packages/llm (increment 9) ---
ANTHROPIC_API_KEY=

# --- apps/api (increment 15) ---
API_PORT=3000
# Long-lived local token the VS Code extension authenticates with (increment 16).
API_LOCAL_TOKEN=
