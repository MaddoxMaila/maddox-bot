{
  "name": "@maddox-bot/worker",
  "version": "0.1.0",
  "private": true,
  "description": "BullMQ consumer that runs agent-core against queued tasks.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@maddox-bot/agent-core": "workspace:*",
    "@maddox-bot/agent-tools": "workspace:*",
    "@maddox-bot/database": "workspace:*",
    "@maddox-bot/events": "workspace:*",
    "@maddox-bot/git": "workspace:*",
    "@maddox-bot/github": "workspace:*",
    "@maddox-bot/jira": "workspace:*",
    "@maddox-bot/llm": "workspace:*",
    "@maddox-bot/queue": "workspace:*",
    "@maddox-bot/sandbox": "workspace:*",
    "@maddox-bot/shared": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "simple-git": "^3.27.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
